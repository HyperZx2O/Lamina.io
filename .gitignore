# ─── Dependencies ─────────────────────────────────────────────
# Auto-installed by `npm install`. Never commit.
node_modules/
node_modules/.cache/

# ─── Build output ────────────────────────────────────────────
# Generated by `npm run build` (Vite). Never commit the dist folder.
dist/
dist-ssr/
*.local-build/

# ─── Environment & secrets ───────────────────────────────────
# Local secrets and machine-specific values. `.env.example` is the
# documented template and SHOULD be committed.
.env
.env.*
!.env.example

# ─── Runtime / generated state ───────────────────────────────
# `data/docs.json` is committed (default docs state) but the
# runtime-mutated history files in `data/history/` are regenerated
# on every server start from the git log, so they must be ignored.
data/history/
data/*.local.json

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Coverage / test artifacts ───────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Editor / OS junk ────────────────────────────────────────
# macOS
.DS_Store
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
*~

# IDEs and editors
.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*.swn
*.bak
*.tmp
*.orig
*.rej

# ─── Local tooling & agent workspaces ───────────────────────
# `husky install` (run by the `prepare` script) creates `.husky/`
# with shell hook files that are environment-specific.
.husky/_/
.husky/.gitignore

# Agent / assistant local state — never commit.
.opencode/
.puku/
.cursor/
.aider*
.continue/
.claude/

# ─── Misc ────────────────────────────────────────────────────
# Vite cache and other build cache directories
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# OS temp / crash dumps
*.crash
*.pid
*.seed
*.pid.lock

# Yarn / pnpm lockfile metadata that's not portable
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
