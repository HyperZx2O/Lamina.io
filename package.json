{
  "name": "lamina-proxy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "start:prod": "npm run build && node server.js",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write .",
    "prepare": "node -e \"if (process.env.CI || process.env.NODE_ENV === 'production') process.exit(0); process.exit(1)\" || husky install",
    "build": "vite build",
    "build:packs": "node scripts/build-study-packs.cjs",
    "build:icons": "node scripts/build-icons.cjs",
    "build:all": "npm run build:packs && npm run build:icons && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "focus-trap-react": "^9.0.2",
    "helmet": "^7.0.0",
    "idb": "^8.0.3",
    "katex": "^0.16.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.50.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0"
  }
}
